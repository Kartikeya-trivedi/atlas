# Copy to .env.local and fill in. Restart the dev server after any change —
# Next.js reads these once at boot.

# ---- Gemini (server-side only, never NEXT_PUBLIC_) ----
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Generation model used for grounded answers, query rewriting and reranking.
GEMINI_MODEL=gemini-2.0-flash

# Embedding model -> must match the vector(N) column width in Postgres.
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768

# ---- Supabase ----
# Project settings -> Data API / API keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS; every read and write goes through it. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Tenancy ----
# The schema is multi-tenant; single-user installs can leave this alone.
POPO_TENANT_ID=00000000-0000-0000-0000-000000000001

# ---- Retrieval defaults (overridable per-query from the UI) ----
RAG_TOP_K=8
RAG_RRF_K=60
RAG_ALPHA=0.5
